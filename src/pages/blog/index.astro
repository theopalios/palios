---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { NEWSLETTER, SITE } from '../../config';
import { cardColor, formatDate, readingTime } from '../../lib/posts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title={`${NEWSLETTER.name} — ${SITE.name}`}
  description={NEWSLETTER.description}
>
  <main
    id="main"
    data-sec="blog"
    style="background-color:var(--sec-blog-bg);color:var(--sec-blog-fg)"
    class="section-pad min-h-svh"
  >
    <div class="wrap">
      <SectionHeading
        eyebrow="The newsletter"
        title={NEWSLETTER.name}
        accent="var(--color-magenta)"
      />
      <p class="mt-6 max-w-2xl text-lg" data-reveal>
        {NEWSLETTER.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        {
          NEWSLETTER.linkedinUrl && (
            <a class="btn bg-ink text-paper" href={NEWSLETTER.linkedinUrl} target="_blank" rel="noopener" data-magnetic>
              Subscribe on LinkedIn
            </a>
          )
        }
        <a class="btn bg-paper text-ink" href="/rss.xml">RSS</a>
      </div>

      {
        posts.length > 0 ? (
          <ul class="mt-16 grid gap-8 md:grid-cols-2" data-reveal-group role="list">
            {posts.map((post, i) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class={`block-card block h-full p-7 md:p-8 transition-transform duration-300 hover:-translate-y-1.5 ${cardColor(post.data.color, i)}`}
                  data-reveal
                >
                  <div class="flex items-center gap-3 text-sm font-bold uppercase tracking-[0.12em]">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{readingTime(post.body)} min read</span>
                  </div>
                  <h2 class="display text-3xl md:text-4xl mt-4">{post.data.title}</h2>
                  <p class="mt-3 leading-relaxed">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                      {post.data.tags.map((t) => (
                        <span class="chip">{t}</span>
                      ))}
                    </div>
                  )}
                  <span class="mt-6 inline-block font-bold underline underline-offset-4 decoration-2">
                    Read →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-16 block-card bg-lime text-ink p-8 md:p-10 max-w-2xl" data-reveal>
            <h2 class="display text-3xl">First issue lands soon.</h2>
            <p class="mt-3">
              {NEWSLETTER.name} goes out weekly. Subscribe on LinkedIn and every issue shows up here
              too.
            </p>
            {NEWSLETTER.linkedinUrl && (
              <a class="btn bg-ink text-paper mt-6" href={NEWSLETTER.linkedinUrl} target="_blank" rel="noopener">
                Subscribe on LinkedIn
              </a>
            )}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</Base>
