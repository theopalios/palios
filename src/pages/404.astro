---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Theo Palios">
  <main
    id="main"
    data-sec="hero"
    style="background-color:var(--sec-hero-bg);color:var(--sec-hero-fg)"
    class="min-h-svh grid place-items-center"
  >
    <div class="wrap text-center py-24">
      <p class="display text-[clamp(6rem,20vw,12rem)] leading-none">
        4<span class="text-tangerine">0</span>4
      </p>
      <p class="mt-4 text-xl">Nothing here — the good stuff is on the homepage.</p>
      <a href="/" class="btn btn-lg bg-ink text-paper mt-8">Take me home</a>
    </div>
  </main>
</Base>
