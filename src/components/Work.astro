---
import SectionHeading from './ui/SectionHeading.astro';
import { work } from '../data/work';
---

<section
  id="work"
  data-work
  data-bg="#7a5cff"
  data-fg="#faf6ee"
  style="background-color:#7a5cff;color:#faf6ee"
  class="section-pad md:min-h-svh md:flex md:flex-col md:justify-center"
>
  <div class="wrap w-full">
    <div class="flex items-end justify-between gap-8">
      <SectionHeading eyebrow="Selected work" title="Built, backed & taken on stage." accent="var(--color-lime)" />
      <div
        class="hidden md:block w-44 h-3 shrink-0 mb-3 border-2 border-paper/80 rounded-full overflow-hidden"
        aria-hidden="true"
      >
        <div class="work-progress h-full bg-lime" data-work-progress></div>
      </div>
    </div>
  </div>

  <div class="mt-10 md:mt-14" data-work-viewport>
    <ul class="work-track strip-pad" data-work-track role="list">
      {
        work.map((w) => (
          <li class={`work-card block-card p-7 md:p-9 flex flex-col gap-5 min-h-[24rem] ${w.cardClass}`}>
            <div class="flex items-center justify-between gap-4">
              <span class="display text-4xl md:text-5xl" data-card-num aria-hidden="true">
                {w.index}
              </span>
              <span class="chip">{w.role}</span>
            </div>
            <div class="flex items-baseline gap-4 flex-wrap">
              <h3 class="display text-3xl md:text-4xl">{w.title}</h3>
              <span class="text-sm font-bold opacity-70">{w.period}</span>
            </div>
            <p class="leading-relaxed">{w.description}</p>
            {w.todo && <p class="text-xs font-bold uppercase tracking-wider opacity-60">{w.todo}</p>}
            <div class="mt-auto flex flex-wrap items-center gap-2">
              {w.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
              {w.href && (
                <a href={w.href} class="ml-auto font-bold underline underline-offset-4 decoration-2" target="_blank" rel="noopener">
                  Visit ↗
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
