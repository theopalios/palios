---
import SectionHeading from './ui/SectionHeading.astro';
import { topics, spokenAt, featuredTalk } from '../data/talks';
import { MAILTO } from '../config';
---

<section
  id="speaking"
  data-sec="speaking"
  style="background-color:var(--sec-speaking-bg);color:var(--sec-speaking-fg)"
  class="section-pad"
>
  <div class="wrap">
    <SectionHeading eyebrow="Speaking" title="Talks that travel." accent="var(--color-sunflower)" />

    <article class="mt-12 block-card bg-paper text-ink p-8 md:p-10" data-reveal>
      <span class="chip">{featuredTalk.context}</span>
      <h3 class="display h-topic mt-5">{featuredTalk.title}</h3>
      <p class="mt-4 text-lg max-w-2xl">{featuredTalk.blurb}</p>
    </article>

    <p class="mt-14 text-sm uppercase tracking-[0.14em] font-bold" data-reveal>
      I also speak and advise on
    </p>

    <ul class="mt-4" data-reveal-group role="list">
      {
        topics.map((t) => (
          <li class="topic-row" style={`--row-c: ${t.rowColor}`} data-reveal>
            <div class="topic-inner py-6 md:py-8 px-2 flex items-baseline gap-5 md:gap-10">
              <span class="display text-lg md:text-2xl opacity-70" aria-hidden="true">
                {t.index}
              </span>
              <div>
                <h3 class="display h-topic">{t.title}</h3>
                <p class="mt-2 md:text-lg font-medium max-w-xl">{t.blurb}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {
      spokenAt.length > 0 && (
        <div class="mt-14 flex flex-wrap items-center gap-3" data-reveal-group>
          <span class="text-sm uppercase tracking-[0.14em] font-bold mr-2" data-reveal>
            Recent rooms
          </span>
          {spokenAt.map((v) => (
            <span class="chip" data-reveal>
              {v}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-12" data-reveal>
      <a class="btn btn-lg bg-paper text-ink" href={MAILTO.speaking} data-magnetic>Invite me to speak</a>
    </div>
  </div>
</section>
