---
import SectionHeading from './ui/SectionHeading.astro';
import { topics, spokenAt } from '../data/talks';
import { MAILTO } from '../config';
---

<section
  id="speaking"
  data-bg="#ff4d24"
  data-fg="#faf6ee"
  style="background-color:#ff4d24;color:#faf6ee"
  class="section-pad"
>
  <div class="wrap">
    <SectionHeading eyebrow="Speaking" title="Talks that travel." accent="var(--color-sunflower)" />

    <ul class="mt-12" data-reveal-group role="list">
      {
        topics.map((t) => (
          <li class="topic-row" style={`--row-c: ${t.rowColor}`} data-reveal>
            <div class="topic-inner py-6 md:py-8 px-2 flex items-baseline gap-5 md:gap-10">
              <span class="display text-lg md:text-2xl opacity-70" aria-hidden="true">
                {t.index}
              </span>
              <div>
                <h3 class="display h-topic">{t.title}</h3>
                <p class="mt-2 md:text-lg opacity-80 max-w-xl">{t.blurb}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- TODO(theo): replace placeholder venues with real ones -->
    <div class="mt-14 flex flex-wrap items-center gap-3" data-reveal-group>
      <span class="text-sm uppercase tracking-[0.14em] font-bold opacity-80 mr-2" data-reveal>
        Recently on stage at
      </span>
      {spokenAt.map((v) => <span class="chip" data-reveal>{v}</span>)}
    </div>

    <div class="mt-12" data-reveal>
      <a class="btn btn-lg bg-paper text-ink" href={MAILTO.speaking} data-magnetic>Invite me to speak</a>
    </div>
  </div>
</section>
