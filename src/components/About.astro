---
import SectionHeading from './ui/SectionHeading.astro';
import { stats } from '../data/stats';
---

<section
  id="about"
  data-bg="#2b3ff3"
  data-fg="#faf6ee"
  style="background-color:#2b3ff3;color:#faf6ee"
  class="section-pad"
>
  <div class="wrap">
    <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start">
      <div class="md:col-span-5" data-reveal="wipe">
        <!-- TODO(theo): swap this placeholder for a real portrait photo -->
        <div class="block-card bg-sunflower text-ink aspect-[4/5] relative overflow-hidden">
          <span class="display absolute inset-0 grid place-items-center text-[clamp(5rem,14vw,9rem)]" aria-hidden="true">
            TP
          </span>
          <span class="chip bg-paper absolute bottom-4 left-4">Portrait — coming soon</span>
        </div>
      </div>

      <div class="md:col-span-7">
        <SectionHeading eyebrow="About" title="Building AI that listens." accent="var(--color-sunflower)" />
        <!-- TODO(theo): confirm bio facts — years, cities, and how you want Noetika described -->
        <div class="mt-8 space-y-5 text-lg max-w-2xl" data-reveal-group>
          <p data-reveal>
            I’m Theo — founder of Unicorn Labs and the person behind Noetika, a platform that treats
            speech as a window on the brain. We help clinicians catch Alzheimer’s, Parkinson’s and
            cognitive decline earlier, just by listening to how people talk.
          </p>
          <p data-reveal>
            Taking AI from a promising model to something a hospital actually deploys — across Europe
            and Asia — taught me what no playbook covers: validation, regulation, procurement, and the
            thousand small decisions between a demo and a deployment.
          </p>
          <p data-reveal>
            That’s what I advise on, and what I speak about: making AI useful where the stakes are real.
          </p>
        </div>
      </div>
    </div>

    <!-- TODO(theo): every number below is a placeholder — confirm before launch -->
    <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12" data-reveal-group>
      {
        stats.map((s) => (
          <div data-reveal>
            <p class="display stat-num">
              <span data-counter={s.value}>{s.value}</span>{s.suffix}
            </p>
            <p class="mt-2 text-sm uppercase tracking-[0.14em] font-bold opacity-80">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
